#!/usr/bin/env bash
# kilix — a Tilix-styled kitty with clickable pane-title-bar buttons.
#
# Runs the forked kitty built from ./src (the "clickable-chrome" fork: each pane
# title bar gets clickable [|] [-] [maximize] [x] buttons) with the
# kilix configuration (Tilix-like per-pane title bars, splits, keybindings,
# theming). Falls back to a prebuilt kitty in the Kilix storage directory if
# the fork is not built yet. Fully self-contained; any extra args are forwarded
# to kitty.
#
#   ./kilix                   # launch kilix
#   ./kilix ls [--panes]      # list live kilix pages/tabs or panes in this instance
#   ./kilix focus <id>        # focus a live tab/pane by ID
#   ./kilix watch <pane-id>   # best-effort read-only text watch of a live pane
#   ./kilix fullscreen        # toggle this tab's OS window fullscreen
#   ./kilix switch [--scope S] # go to a page or pane (F12; scope all|page|other)
#   ./kilix new-pane [DIR]    # open a pane left/right/down of this one
#   ./kilix new-tab [--title T] # open a new page
#   ./kilix mux [name]        # open a tmux-backed kilix tab for real attach/view
#   ./kilix remote ...        # expose/attach a live graphical pane
#   ./kilix screen-size ...   # show/increase/decrease/reset terminal scale
#   ./kilix settings          # shared chrome/game settings TUI and CLI
#   ./kilix games ...         # list, play, enable, or disable stack games
#   ./kilix power ...         # logout|reboot|poweroff, no confirmation here
#   ./kilix launcher          # catalog TUI: stack programs, apps, launchers
#   ./kilix app run ID        # install/run one pinned catalog application
#   ./kilix app window ID     # render a terminal app in a desktop window
#   ./kilix laptop ...        # list/open/status/close laptop session profiles
#   ./kilix temps [args]       # run the pinned graphical thermal dashboard
#   ./kilix memory [args]      # run the graphical RAM/pressure dashboard
#   ./kilix tmux [args]        # install/run the pinned Tmux Manager
#   ./kilix amp [args]         # install/run the pinned Media Player
#   ./kilix amp --headless     # run its control-socket backend, no windows
#   ./kilix pdf-view PDF       # install/run the terminal-native PDF viewer
#   ./kilix pdf [PDF]          # install/run pinned PDF-to-Markdown conversion
#   ./kilix speak [TEXT...]    # read a pane, or the given text, aloud
#   ./kilix dictate           # recognize one spoken utterance
#   ./kilix tts | stt [args]  # run the read-aloud / dictation TUIs
#   ./kilix voice status      # voice status, install, doctor, stop
#   ./kilix bonsai [args]     # BitNet model store: browse, download, verify
#   ./kilix rtsp [args]       # watch RTSP cameras: view one, or a grid
#   ./kilix nvr [args]        # record cameras, detect, review what happened
#   ./kilix look [args]       # what is in a picture, a clip, or a camera
#   ./kilix yolo [install]    # the detection runtime both of them use
#   ./kilix mask [args]       # paint region maps over an image (camera masks,
#                             #   walkable space); --render/--selftest headless
#   ./kilix open-url [URL]    # real browser first; in-pane fallback
#   ./kilix browse [URL]      # compatibility alias for open-url
#   ./kilix chawan [URL]      # install/run the Chawan text browser
#   ./kilix status            # show version, engine, config, and provider
#   ./kilix power ACTION      # logout|reboot|poweroff — no prompt, no UI
#   ./kilix security password-status  # is the login password still the default?
#   ./kilix update            # verified-origin, clean, fast-forward/ref update
#   ./kilix update --stack    # most complete updater present, then kilix
#   ./kilix desktop           # launch the configured desktop provider
#   ./kilix cap               # launch/install the Kilix Cap mansion desktop
#   ./kilix tui               # launch/install the Kilix TUI desktop
#   ./kilix land              # launch/install the Kilix Land desktop
#   ./kilix icewm             # launch/install the Kilix IceWM desktop
#   ./kilix --build           # build the forked kitty from ./src
#   ./kilix --which           # print the kitty binary kilix uses + its version
#   ./kilix --install-desktop # desktop entry + icon (own taskbar group)
set -euo pipefail
umask 077

# Resolve symlinks so `ln -s .../kilix ~/.local/bin/kilix` still finds the project.
_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
KILIX_HOME="$(cd "$(dirname "$_self")" && pwd)"
GPU_TERMINAL_SOURCE_HOME="${GPU_TERMINAL_SOURCE_HOME:-$HOME/.local/gpu_terminal/sources}"
GPU_TERMINAL_HOME="${GPU_TERMINAL_HOME:-$HOME/.local/gpu_terminal}"
GPU_TERMINAL_SETTINGS_FILE="${GPU_TERMINAL_SETTINGS_FILE:-$GPU_TERMINAL_HOME/settings.conf}"
KILIX_STORAGE_HOME="${KILIX_STORAGE_HOME:-$GPU_TERMINAL_HOME/kilix}"
KILIX_CONFIG_HOME="${KILIX_CONFIG_HOME:-$KILIX_STORAGE_HOME/config}"
KILIX_STATE_DIRECTORY="${KILIX_STATE_DIRECTORY:-$KILIX_STORAGE_HOME/state}"
KILIX_CACHE_HOME="${KILIX_CACHE_HOME:-$KILIX_STORAGE_HOME/cache}"
KILIX_SESSION_HOME="${KILIX_SESSION_HOME:-$KILIX_STORAGE_HOME/session}"
KILIX_DATA_HOME="${KILIX_DATA_HOME:-$KILIX_STORAGE_HOME/data}"
KILIX_BUILD_DIRECTORY="${KILIX_BUILD_DIRECTORY:-$KILIX_STORAGE_HOME/build}"
KILIX_PREBUILT_HOME="${KILIX_PREBUILT_HOME:-$KILIX_STORAGE_HOME/prebuilt/kitty.app}"
KILIX95_STORAGE_HOME="${KILIX95_STORAGE_HOME:-$GPU_TERMINAL_HOME/kilix-95}"
KILIX95_CONFIG_HOME="${KILIX95_CONFIG_HOME:-$KILIX95_STORAGE_HOME/config}"
KILIX95_STATE_HOME="${KILIX95_STATE_HOME:-$KILIX95_STORAGE_HOME/state}"
KILIX95_CACHE_HOME="${KILIX95_CACHE_HOME:-$KILIX95_STORAGE_HOME/cache}"
KILIX95_SESSION_HOME="${KILIX95_SESSION_HOME:-$KILIX95_STORAGE_HOME/session}"
KILIX95_DATA_HOME="${KILIX95_DATA_HOME:-$KILIX95_STORAGE_HOME/data}"
export GPU_TERMINAL_SOURCE_HOME GPU_TERMINAL_HOME GPU_TERMINAL_SETTINGS_FILE
export KILIX_STORAGE_HOME KILIX_CONFIG_HOME
export KILIX_STATE_DIRECTORY KILIX_CACHE_HOME KILIX_SESSION_HOME KILIX_DATA_HOME
export KILIX_BUILD_DIRECTORY KILIX_PREBUILT_HOME
export KILIX95_STORAGE_HOME KILIX95_CONFIG_HOME KILIX95_STATE_HOME
export KILIX95_CACHE_HOME KILIX95_SESSION_HOME KILIX95_DATA_HOME

_kilix_validate_private_storage_layout() {
  local storage private home source
  storage="$(realpath -m -- "$KILIX_STORAGE_HOME" 2>/dev/null)" || return 1
  home="$(realpath -m -- "$HOME" 2>/dev/null)" || return 1
  source="$(realpath -m -- "$KILIX_HOME" 2>/dev/null)" || return 1
  if [ "$storage" = / ] || [ "$storage" = "$home" ] \
       || [ "$storage" = "$source" ]; then
    echo "kilix: refusing broad or source-tree storage root: $storage" >&2
    return 1
  fi
  case "$storage" in "$source"/*)
    echo "kilix: refusing storage inside the Kilix source checkout" >&2
    return 1 ;;
  esac
  case "$source" in "$storage"/*)
    echo "kilix: refusing storage that contains the Kilix source checkout" >&2
    return 1 ;;
  esac
  for private in "$KILIX_CONFIG_HOME" "$KILIX_STATE_DIRECTORY" \
                 "$KILIX_CACHE_HOME" "$KILIX_SESSION_HOME" \
                 "$KILIX_DATA_HOME" "$KILIX_BUILD_DIRECTORY"; do
    private="$(realpath -m -- "$private" 2>/dev/null)" || return 1
    case "$private" in "$storage"/*) ;;
      *) echo "kilix: writable roots must be strict descendants of Kilix storage: $private" >&2
         return 1 ;;
    esac
  done
}

_kilix_ensure_private_directory() {
  local path="$1" label="$2" owner mode
  if [ -e "$path" ] || [ -L "$path" ]; then
    if [ ! -d "$path" ] || [ -L "$path" ]; then
      echo "kilix: refusing unsafe $label directory: $path" >&2
      return 1
    fi
  else
    mkdir -p -- "$path" || return 1
  fi
  owner="$(stat -c '%u' -- "$path" 2>/dev/null)" || return 1
  [ "$owner" = "$(id -u)" ] || {
    echo "kilix: $label directory is not owned by the current user: $path" >&2
    return 1
  }
  chmod 0700 -- "$path" || return 1
  mode="$(stat -c '%a' -- "$path" 2>/dev/null)" || return 1
  [ "$mode" = 700 ] || {
    echo "kilix: $label directory is not mode 0700: $path" >&2
    return 1
  }
}

# Read the session-logging values in one interpreter start rather than one per
# value, so an ordinary launch pays for Python only once.
_KILIX_TRANSCRIPT_ENABLED=0
_KILIX_TRANSCRIPT_LIMIT=8388608
_KILIX_TRANSCRIPT_GRAPHICS=elide
_KILIX_TRANSCRIPT_TOTAL=5368709120
_KILIX_TRANSCRIPT_ARCHIVE=1073741824
_kilix_read_transcript_config() {
  local line
  while IFS= read -r line; do
    case "$line" in
      enabled=*)  _KILIX_TRANSCRIPT_ENABLED="${line#enabled=}" ;;
      limit=*)    _KILIX_TRANSCRIPT_LIMIT="${line#limit=}" ;;
      graphics=*) _KILIX_TRANSCRIPT_GRAPHICS="${line#graphics=}" ;;
      total=*)    _KILIX_TRANSCRIPT_TOTAL="${line#total=}" ;;
      archive=*)  _KILIX_TRANSCRIPT_ARCHIVE="${line#archive=}" ;;
    esac
  done < <(python3 -c "
import sys
sys.path.insert(0, '$KILIX_HOME/config')
from kilix_sdk import settings
print('enabled=%d' % (1 if settings.transcript_enabled() else 0))
print('limit=%d' % settings.transcript_limit())
print('graphics=%s' % settings.transcript_graphics())
print('total=%d' % settings.transcript_total())
print('archive=%d' % settings.transcript_archive_total())
" 2>/dev/null)
}

# Session IDs the broker still owns. A live pane's log is never compressed or
# removed, because the broker holds the descriptor and would keep writing to a
# file that no longer has a name.
_kilix_transcript_live_ids() {
  local broker
  if [ -n "${KITTY_PTY_BROKER_EXECUTABLE:-}" ] \
       && [ -x "$KITTY_PTY_BROKER_EXECUTABLE" ]; then
    broker="$KITTY_PTY_BROKER_EXECUTABLE"
  else
    broker="$("$KILIX_HOME/scripts/build-pty-broker.sh" --print-path 2>/dev/null)" \
      && [ -x "$broker" ] || return 1
  fi
  "$broker" --runtime-dir "$KILIX_SESSION_HOME/pty-broker" list --json 2>/dev/null \
    | python3 -c 'import json,sys
try:
    print("\n".join(str(i.get("id", "")) for i in json.load(sys.stdin)))
except Exception:
    raise SystemExit(1)' 2>/dev/null
}

# Describe one transcript from the sidecar the fork writes when the pane is
# spawned. A session ID is random, so without this the index can only offer a
# hash -- and the pane you are hunting for is the one you can name by the
# directory it was sitting in. Sidecars stay beside the top-level directory
# whatever tier their log has reached, so a lookup never has to guess.
#
# The second argument is the column budget the caller has left on this row;
# 0 means unbounded. What distinguishes one pane from its neighbours is the
# END of a path -- the leaf directory, a command's last argument -- so a
# label that has to shrink gives up its head, never its tail. A blind
# right-hand clip here once made every pane on the same project look
# identical.
_kilix_transcript_label() {
  local meta="$1" budget="${2:-0}" cwd="" cmd="" line room
  [ -f "$meta" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      cwd=*) cwd="${line#cwd=}" ;;
      cmd=*) cmd="${line#cmd=}" ;;
    esac
  done < "$meta"
  # The directory is what gets scanned, so spend the width on it and keep
  # $HOME short.
  case "$cwd" in
    "$HOME") cwd="~" ;;
    "$HOME"/*) cwd="~${cwd#"$HOME"}" ;;
  esac
  if [ "$budget" -gt 0 ]; then
    [ "$budget" -ge 20 ] || budget=20
    if [ -n "$cwd" ] && [ -n "$cmd" ] && [ "$budget" -lt 36 ]; then
      # Too narrow for both parts; the directory is the better name.
      cmd=""
    fi
    if [ -n "$cwd" ] && [ -n "$cmd" ]; then
      room=$(( budget - ${#cwd} - 3 ))
      if [ "$room" -lt 16 ]; then
        # The command keeps a readable tail; the directory pays the rest,
        # from its head.
        room=16
        cwd="…${cwd: -$(( budget - 20 ))}"
      fi
      [ "${#cmd}" -le "$room" ] || cmd="${cmd:0:$(( (room - 1) / 3 ))}…${cmd: -$(( room - 1 - (room - 1) / 3 ))}"
    elif [ -n "$cwd" ]; then
      [ "${#cwd}" -le "$budget" ] || cwd="…${cwd: -$(( budget - 1 ))}"
    elif [ -n "$cmd" ]; then
      [ "${#cmd}" -le "$budget" ] || cmd="${cmd:0:$(( (budget - 1) / 3 ))}…${cmd: -$(( budget - 1 - (budget - 1) / 3 ))}"
    fi
  fi
  if [ -n "$cwd" ] && [ -n "$cmd" ]; then printf '  %s — %s' "$cwd" "$cmd"
  elif [ -n "$cwd" ]; then printf '  %s' "$cwd"
  elif [ -n "$cmd" ]; then printf '  %s' "$cmd"
  fi
}

# Enforce the directory budgets. Three tiers: a pane's log is plain only while
# the pane lives, becomes a zstd -3 file as soon as the pane dies, and is
# recompressed at zstd -9 once the recent budget fills. Level costs compression
# time rather than recall -- every level decompresses in well under a second --
# so the denser older tier is not a slower one to read.
_kilix_transcript_reap() (
  local dir="$1" recent_budget="$2" archive_budget="$3" quiet="${4:-0}"
  [ -d "$dir" ] || return 0
  local recent="$dir/recent" archive="$dir/archive"
  local live compressed=0 moved=0 removed=0 errors=0 used file size name tmp
  command -v flock >/dev/null 2>&1 || {
    [ "$quiet" = 1 ] || echo "kilix: flock is required to prune transcripts" >&2
    return 0
  }
  exec 9>"$KILIX_STATE_DIRECTORY/transcript-reaper.lock" || return 0
  chmod 0600 "$KILIX_STATE_DIRECTORY/transcript-reaper.lock" 2>/dev/null || return 0
  if ! flock -n 9; then
    [ "$quiet" = 1 ] || echo "kilix: another transcript pass is already running"
    return 0
  fi
  if ! live="$(_kilix_transcript_live_ids)"; then
    [ "$quiet" = 1 ] \
      || echo "kilix: could not identify live panes; transcripts were left unchanged" >&2
    return 0
  fi
  command -v zstd >/dev/null 2>&1 || {
    [ "$quiet" = 1 ] || echo "zstd is not installed; transcripts are not bounded" >&2
    return 0
  }

  # 1. Every dead pane's log becomes a compressed one immediately, so nothing
  #    is ever stored uncompressed for longer than the pane's own lifetime.
  mkdir -p "$recent" && chmod 700 "$recent" 2>/dev/null
  for file in "$dir"/*.log; do
    [ -f "$file" ] || continue
    name="${file##*/}"; name="${name%.log}"
    printf '%s\n' "$live" | grep -qxF "$name" && continue
    # An automatic pass gives a brand-new file time to appear in the broker's
    # live-session index before deciding it is dead. Explicit prune/archive
    # commands have already asked the broker synchronously and need no delay.
    if [ "$quiet" = 1 ] \
         && find "$file" -mmin -1 -print -quit 2>/dev/null | grep -q .; then
      continue
    fi
    tmp=""
    if tmp="$(mktemp "$recent/.$name.log.zst.XXXXXX")" \
         && zstd -3 -q -f -o "$tmp" "$file" 2>/dev/null \
         && chmod 0600 "$tmp" \
         && mv -f -- "$tmp" "$recent/$name.log.zst"; then
      if rm -f -- "$file"; then
        compressed=$((compressed + 1))
      else
        errors=$((errors + 1))
      fi
    else
      [ -z "$tmp" ] || rm -f -- "$tmp"
      errors=$((errors + 1))
    fi
  done

  # 2. Over the recent budget, recompress oldest-first into the denser tier.
  used=$(find "$recent" -maxdepth 1 -type f -name '*.log.zst' -printf '%s\n' \
    2>/dev/null | awk '{s+=$1} END {print s+0}')
  if [ "$used" -gt "$recent_budget" ]; then
    mkdir -p "$archive" && chmod 700 "$archive" 2>/dev/null
    while IFS= read -r file; do
      [ "$used" -gt "$recent_budget" ] || break
      [ -n "$file" ] || break
      name="${file##*/}"; name="${name%.log.zst}"
      size=$(stat -c%s "$file" 2>/dev/null || echo 0)
      if [ "$archive_budget" -eq 0 ]; then
        rm -f -- "$file" && removed=$((removed + 1))
        used=$((used - size))
      else
        tmp=""
        if tmp="$(mktemp "$archive/.$name.log.zst.XXXXXX")" \
             && zstd -dcq -- "$file" 2>/dev/null \
                | zstd -9 -q -f -o "$tmp" 2>/dev/null \
             && chmod 0600 "$tmp" \
             && touch -r "$file" "$tmp" \
             && mv -f -- "$tmp" "$archive/$name.log.zst"; then
          if rm -f -- "$file"; then
            moved=$((moved + 1))
            used=$((used - size))
          else
            errors=$((errors + 1))
          fi
        else
          [ -z "$tmp" ] || rm -f -- "$tmp"
          errors=$((errors + 1))
        fi
      fi
    done < <(find "$recent" -maxdepth 1 -type f -name '*.log.zst' -printf '%T@ %p\n' \
      2>/dev/null | sort -n | cut -d' ' -f2-)
  fi

  # 3. Over the older budget too, the oldest history is dropped.
  if [ -d "$archive" ]; then
    used=$(find "$archive" -maxdepth 1 -type f -name '*.log.zst' -printf '%s\n' \
      2>/dev/null | awk '{s+=$1} END {print s+0}')
    while [ "$used" -gt "$archive_budget" ]; do
      file="$(find "$archive" -maxdepth 1 -type f -name '*.log.zst' -printf '%T@ %p\n' \
        2>/dev/null | sort -n | head -1 | cut -d' ' -f2-)"
      [ -n "$file" ] || break
      size=$(stat -c%s "$file" 2>/dev/null || echo 0)
      rm -f -- "$file" && removed=$((removed + 1))
      used=$((used - size))
    done
  fi

  # 4. A sidecar only means something while its log still exists in some tier,
  #    so drop the ones whose log has aged out of all three. A pane writes its
  #    sidecar just before the broker creates the log, so an automatic pass
  #    spares brand-new ones exactly as step 1 does.
  for file in "$dir"/*.meta; do
    [ -f "$file" ] || continue
    name="${file##*/}"; name="${name%.meta}"
    [ ! -f "$dir/$name.log" ] || continue
    [ ! -f "$recent/$name.log.zst" ] || continue
    [ ! -f "$archive/$name.log.zst" ] || continue
    if [ "$quiet" = 1 ] \
         && find "$file" -mmin -1 -print -quit 2>/dev/null | grep -q .; then
      continue
    fi
    rm -f -- "$file" || errors=$((errors + 1))
  done

  [ "$quiet" = 1 ] \
    || echo "compressed $compressed, recompressed $moved, removed $removed, errors $errors (live panes kept)"
)

_kilix_transcript_reap_periodically() {
  local frontend_pid="$1" dir="$2"
  while kill -0 "$frontend_pid" 2>/dev/null; do
    _kilix_read_transcript_config
    _kilix_transcript_reap "$dir" "$_KILIX_TRANSCRIPT_TOTAL" \
      "$_KILIX_TRANSCRIPT_ARCHIVE" 1
    sleep 60
  done
}

_kilix_validate_private_storage_layout || exit 1
_kilix_ensure_private_directory "$KILIX_STORAGE_HOME" storage || exit 1
_kilix_ensure_private_directory "$KILIX_STATE_DIRECTORY" state || exit 1
_kilix_ensure_private_directory "$KILIX_BUILD_DIRECTORY" build || exit 1
_kilix_ensure_private_directory "$KILIX_CACHE_HOME" cache || exit 1
_kilix_ensure_private_directory "$KILIX_SESSION_HOME" session || exit 1
_kilix_validate_private_storage_layout || exit 1

FORK="$KILIX_BUILD_DIRECTORY/current/src/kitty/launcher/kitty"
PREBUILT="$KILIX_PREBUILT_HOME/bin/kitty"

# A fresh install owns this complete tree. Legacy XDG/source-tree locations are
# deliberately never moved: provider storage is isolated and launch is free of
# cross-project data mutations.
export KITTY_CACHE_DIRECTORY="${KITTY_CACHE_DIRECTORY:-$KILIX_CACHE_HOME/kitty}"
export KITTY_RUNTIME_DIRECTORY="${KITTY_RUNTIME_DIRECTORY:-$KILIX_SESSION_HOME/kitty}"
# Tracked files under ./config are immutable defaults.  Normal runtime changes
# live under the Kilix storage root so Settings/screen-size never dirty the checkout.
# The generated user kitty.conf includes the tracked default file, which means
# new defaults arrive on update without overwriting user overrides.  The
# KILIX_CONFIG_DIRECTORY override remains available for tests/custom packaging.
KILIX_DEFAULT_CONFIG_DIRECTORY="$KILIX_HOME/config"
KILIX_USER_CONFIG_DIRECTORY="$KILIX_CONFIG_HOME"
_KILIX_DEFAULTS_LINK="$KILIX_USER_CONFIG_DIRECTORY/.kilix-defaults.conf"
_KILIX_CONFIG_MARKER="# Kilix user overrides. Tracked defaults are loaded first."

_kilix_refresh_managed_link() {
  _target="$1" _source="$2"
  if [ -L "$_target" ]; then
    ln -sfn "$_source" "$_target"
  elif [ ! -e "$_target" ]; then
    ln -s "$_source" "$_target"
  fi
}

_kilix_refresh_generated_include() {
  _target="$1"
  [ -f "$_target" ] || return 0
  grep -qF "$_KILIX_CONFIG_MARKER" "$_target" 2>/dev/null || return 0
  _tmp="$(mktemp "${_target}.tmp.XXXXXX")"
  awk -v marker="$_KILIX_CONFIG_MARKER" '
    $0 == marker { managed=1; print; next }
    managed && !done && /^include / {
      print "include .kilix-defaults.conf"; done=1; next
    }
    { print }
    END { if (!done) print "include .kilix-defaults.conf" }
  ' "$_target" >"$_tmp"
  mv "$_tmp" "$_target"
}

_kilix_init_user_config() {
  _kilix_ensure_private_directory "$KILIX_USER_CONFIG_DIRECTORY" config || return 1
  _user_kitty="$KILIX_USER_CONFIG_DIRECTORY/kitty.conf"
  _user_env="$KILIX_USER_CONFIG_DIRECTORY/kilix.env"

  _kilix_refresh_managed_link "$_KILIX_DEFAULTS_LINK" \
    "$KILIX_DEFAULT_CONFIG_DIRECTORY/kitty.conf"

  if [ ! -e "$_user_kitty" ]; then
    printf '%s\n%s\n' "$_KILIX_CONFIG_MARKER" \
      'include .kilix-defaults.conf' >"$_user_kitty"
  fi
  _kilix_refresh_generated_include "$_user_kitty"
  if [ ! -e "$_user_env" ]; then
    printf '%s\n' '# Kilix user runtime overrides (KEY=value; not shell code).' >"$_user_env"
  fi
  chmod 600 "$_user_kitty" "$_user_env" 2>/dev/null || true

  # Refresh managed symlinks on every launch so moving/reinstalling the checkout
  # does not strand the XDG configuration at an obsolete absolute path.
  for _asset in kitty.app.png kitty.app-128.png kilix-512.png \
                kilix_rc_auth.py open-actions.conf; do
    _kilix_refresh_managed_link "$KILIX_USER_CONFIG_DIRECTORY/$_asset" \
      "$KILIX_DEFAULT_CONFIG_DIRECTORY/$_asset" 2>/dev/null || true
  done
}

_kilix_init_rc_password() {
  local password_file="$KILIX_SESSION_HOME/rc-password"
  local config_file="$KILIX_SESSION_HOME/rc-password.conf"
  local tmp password metadata
  if [ ! -e "$password_file" ] && [ ! -L "$password_file" ]; then
    tmp="$(mktemp "$KILIX_SESSION_HOME/.rc-password.XXXXXX")" || return 1
    password="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    if [[ ! "$password" =~ ^[0-9a-f]{64}$ ]]; then
      rm -f -- "$tmp"
      echo "kilix: could not generate a remote-control password" >&2
      return 1
    fi
    printf '%s\n' "$password" >"$tmp"
    chmod 0600 "$tmp" || { rm -f -- "$tmp"; return 1; }
    ln "$tmp" "$password_file" 2>/dev/null || true
    rm -f -- "$tmp"
  fi
  if [ ! -f "$password_file" ] || [ -L "$password_file" ]; then
    echo "kilix: refusing unsafe remote-control password file" >&2
    return 1
  fi
  metadata="$(stat -c '%u:%a:%h' -- "$password_file" 2>/dev/null)" || return 1
  if [ "$metadata" != "$(id -u):600:1" ]; then
    echo "kilix: remote-control password file must be private" >&2
    return 1
  fi
  password="$(tr -d '\n' <"$password_file")"
  if [[ ! "$password" =~ ^[0-9a-f]{64}$ ]]; then
    echo "kilix: remote-control password file is invalid" >&2
    return 1
  fi
  # The credential is scoped at the terminal, not at the caller: this line is
  # the whole list of commands the password will ever authorise, so a tool
  # holding it still cannot do anything absent from here.
  #
  # close-window, close-tab and set-tab-title were added for `kilix-switch`,
  # which can act on what it lists rather than sending you elsewhere to finish.
  # They are a real widening and worth stating plainly: anything able to read
  # this file can now close a pane. Two things bound that. The file is 0600,
  # single-link, owned by the user and checked as such above, so the reader is
  # already the user themselves. And get-text — which reads what is on another
  # pane's screen — has been in this list since `kilix watch`, so the surface
  # was never a read-only one; closing a window destroys less than reading it
  # discloses.
  #
  # The custom checker adds one narrow input route for `kilix remote`: send-text
  # must target exactly one broker session through its environment marker and
  # may carry only a bounded base64 byte chunk. The command name is deliberately
  # absent from the wildcard list, so the checker is the only route to it.
  tmp="$(mktemp "$KILIX_SESSION_HOME/.rc-config.XXXXXX")" || return 1
  printf 'remote_control_password "%s" launch ls focus-window focus-tab get-text close-window close-tab set-tab-title "%s"\n' \
    "$password" "$KILIX_HOME/config/kilix_mux_rc_auth.py" >"$tmp"
  chmod 0600 "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$config_file"
  KILIX_RC_PASSWORD_FILE="$password_file"
  KILIX_RC_CONFIG_FILE="$config_file"
  export KILIX_RC_PASSWORD_FILE KILIX_RC_CONFIG_FILE
}

