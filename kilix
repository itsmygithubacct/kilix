      KILIX_TUI_UTILS_TRUST_EXISTING_CHECKOUT|KILIX_TUI_UTILS_ALLOW_MUTABLE_REF|KILIX_TUI_UTILS_PREFIX|\
      KILIX_LAND_DESKTOP_AUTO_INSTALL|KILIX_LAND_DESKTOP_DIR|KILIX_LAND_DESKTOP_REPO|KILIX_LAND_DESKTOP_REF|\
