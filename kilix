# Never resolved through the installer, unlike the two TUIs: asking to read a
# pane aloud must not be able to start a git clone and a 41 MB model download.
# An absent daemon is a missing optional dependency, so it degrades voice with
# an actionable message rather than turning a speak into an install.
_kilix_voice_daemon() {
  local resolved
  resolved="$(command -v kilix-voiced 2>/dev/null || true)"
  [ -n "$resolved" ] || resolved="$_KILIX_VOICE_PREFIX/bin/kilix-voiced"
  [ -x "$resolved" ] || return 0
  printf '%s\n' "$resolved"
}

# Every request this CLI makes of kilix-voiced: connect, send one JSON line,
# read one reply. It lives here rather than in config/remote.py because that
# file speaks kitty remote control, which this deliberately does not use.
# Emitted rather than fed to `python3 -` because `speak` reads the text to say
# on stdin, and a script on stdin would eat it.
_kilix_voice_client() {
  cat <<'PY'
import json
import os
import re
import socket
import subprocess
import sys
import time

SESSION = os.environ.get("KILIX_VOICE_SESSION", "")
CONTROL = os.path.join(SESSION, "control.sock")
DAEMON = os.environ.get("KILIX_VOICE_DAEMON", "")
SPAWN = os.environ.get("KILIX_VOICE_SPAWN") == "1"
# The daemon answers as soon as it has accepted a request; audio happens after
# that, so a slower reply than this is a wedged daemon, not a long sentence.
REPLY_TIMEOUT = 5.0
SPAWN_TIMEOUT = 8.0
MAX_REQUEST_BYTES = 192 * 1024
# A recognizer should never emit these, but stdout here is usually a live pane,
# so a transcript is injected text like any other. Newlines survive because the
# shell this prints into is not reading a command line; everything that could
# move the cursor or introduce an escape sequence does not, including the 8-bit
# CSI and OSC introducers in the C1 range.
CONTROL_CHARACTERS = re.compile(r"[\x00-\x09\x0b-\x1f\x7f-\x9f]")


class AmbiguousRequest(RuntimeError):
    """The daemon may have accepted a request whose reply was lost."""


class RefusedRequest(RuntimeError):
    """The daemon definitively rejected a request before starting a turn."""


def die(message, code=1):
    print("kilix voice: %s" % message, file=sys.stderr)
    raise SystemExit(code)


def clean(text):
    return CONTROL_CHARACTERS.sub("", text)


def spawn_daemon():
    if not DAEMON:
        die("kilix-voiced is not installed; run 'kilix voice install'")
    try:
        subprocess.Popen(
            [DAEMON],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as error:
        die("could not start %s: %s" % (DAEMON, error))


def connect():
    """Connect to the arbiter, starting it once when nothing is listening."""
    spawned = not SPAWN
    deadline = time.monotonic() + SPAWN_TIMEOUT
    while True:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        client.settimeout(REPLY_TIMEOUT)
        try:
            client.connect(CONTROL)
            return client
        except OSError:
            client.close()
        if not spawned:
            spawn_daemon()
            spawned = True
        elif not SPAWN or time.monotonic() >= deadline:
            die("the voice daemon is not running (%s)" % CONTROL)
        time.sleep(0.2)


def request(client, message):
    payload = (json.dumps(
        message, ensure_ascii=False, separators=(",", ":")) + "\n"
    ).encode("utf-8")
    if len(payload) > MAX_REQUEST_BYTES:
        raise RefusedRequest(
            "the voice request is too large for one local control packet "
            "(%d bytes; limit %d). Read a smaller extent or shorter text."
            % (len(payload), MAX_REQUEST_BYTES))
    try:
        client.sendall(payload)
    except OSError as error:
        raise AmbiguousRequest(
            "the voice daemon connection failed during a %s request: %s"
            % (message["op"], error)) from error
    try:
        raw = client.recv(65536)
    except OSError as error:
        raise AmbiguousRequest(
            "the voice daemon did not answer a %s request" % message["op"]
        ) from error
    if not raw:
        raise AmbiguousRequest(
            "the voice daemon closed the %s connection without a reply"
            % message["op"])
    try:
        reply = json.loads(raw.decode("utf-8", "replace"))
    except ValueError as error:
        raise AmbiguousRequest(
            "the voice daemon sent an unreadable %s reply" % message["op"]
        ) from error
    if not isinstance(reply, dict):
        raise AmbiguousRequest(
            "the voice daemon sent an unreadable %s reply" % message["op"])
    # A status reply is a payload rather than an acknowledgement, so only an
    # explicit refusal is an error.
    if reply.get("ok") is False:
        raise RefusedRequest(str(reply.get("error") or "request refused"))
    return reply


def connect_existing():
    """Connect without spawning; compensation must never start a new daemon."""
    client = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    client.settimeout(REPLY_TIMEOUT)
    try:
        client.connect(CONTROL)
    except OSError:
        client.close()
        return None
    return client


def exchange_existing(message):
    client = connect_existing()
    if client is None:
        raise AmbiguousRequest("the voice daemon is no longer reachable")
    try:
        return request(client, message)
    finally:
        client.close()


def best_effort_stop(op):
    try:
        exchange_existing({"op": op})
    except (AmbiguousRequest, RefusedRequest):
        pass


def stop_with_retry(op):
    """Return an error string unless one of two idempotent stops is confirmed."""
    error = "the voice daemon is no longer reachable"
    for _attempt in range(2):
        try:
            exchange_existing({"op": op})
        except AmbiguousRequest as failure:
            error = str(failure)
            continue
        except RefusedRequest as failure:
            return str(failure)
        return None
    return error


def one_request(message, ambiguous_stop=None):
    """Use one connection for one request; kilix-voiced closes after reply."""
    client = None
    try:
        client = connect()
        try:
            return request(client, message)
        except AmbiguousRequest as error:
            if ambiguous_stop is not None:
                best_effort_stop(ambiguous_stop)
            die(str(error))
        except RefusedRequest as error:
            die(str(error))
        except BaseException:
            if ambiguous_stop is not None:
                best_effort_stop(ambiguous_stop)
            raise
    finally:
        if client is not None:
            client.close()


def daemon_status():
    reply = one_request({"op": "status"})
    status = reply.get("status")
    if not isinstance(status, dict):
        die("the voice daemon sent an unreadable status")
    return status


def cmd_speak():
    text = sys.stdin.read()
    one_request(
        {"op": "speak", "text": text}, ambiguous_stop="stop-speech")


def cmd_stop():
    # Attempt both independently: a failed speaker request must never prevent
    # the microphone stop. Each stop is idempotently retried once on ambiguity.
    errors = []
    for op in ("stop-speech", "stop-dictation"):
        if error := stop_with_retry(op):
            errors.append("%s: %s" % (op, error))
    if errors:
        die("could not confirm all voice stopped (%s)" % "; ".join(errors))


def cmd_status():
    reply = daemon_status()
    for key in ("speaking", "listening", "engines", "model", "device", "version"):
        value = reply.get(key)
        if isinstance(value, (dict, list)):
            value = json.dumps(value, separators=(",", ":"))
        print("%s=%s" % (key, "" if value is None else value))


def cmd_dictate_pane(pane, seconds):
    # The socket belongs to the fork, which created it for this pane when the
    # user clicked its microphone and is the only thing that writes to the PTY.
    sock = os.path.join(SESSION, "dictate-%s.sock" % pane)
    del seconds  # the daemon reads the shared max-seconds setting
    reply = one_request(
        {"op": "dictate", "sock": sock},
        ambiguous_stop="stop-dictation")
    print("kilix dictate: listening for pane %s (id %s)"
          % (pane, reply.get("id", "?")), file=sys.stderr)


def cmd_dictate(seconds):
    path = os.path.join(SESSION, "cli-%d.sock" % os.getpid())
    server = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    interactive = sys.stderr.isatty()
    accepted = False
    try:
        if os.path.lexists(path):
            os.unlink(path)
        server.bind(path)
        os.chmod(path, 0o600)
        one_request(
            {"op": "dictate", "sock": path},
            ambiguous_stop="stop-dictation")
        accepted = True
        server.settimeout(0.25)
        deadline = time.monotonic() + seconds
        final_deadline = deadline + 5.0
        final = None
        stop_requested = False
        while final is None and time.monotonic() < final_deadline:
            if not stop_requested and time.monotonic() >= deadline:
                if error := stop_with_retry("stop-dictation"):
                    die("could not stop dictation: %s" % error)
                stop_requested = True
            try:
                datagram = server.recv(65536)
            except socket.timeout:
                continue
            except KeyboardInterrupt:
                if stop_requested:
                    die("dictation interrupted while waiting for the final result")
                if error := stop_with_retry("stop-dictation"):
                    die("could not stop dictation: %s" % error)
                stop_requested = True
                final_deadline = min(final_deadline, time.monotonic() + 5.0)
                continue
            except OSError:
                continue
            try:
                event = json.loads(datagram.decode("utf-8", "replace"))
            except ValueError:
                continue
            if "error" in event:
                accepted = False
                die(str(event["error"]))
            if "final" in event:
                final = str(event["final"])
                accepted = False
            elif "partial" in event and interactive:
                sys.stderr.write("\r\033[2K%s" % clean(str(event["partial"]))[:200])
                sys.stderr.flush()
        if interactive:
            sys.stderr.write("\r\033[2K")
            sys.stderr.flush()
        if final is None:
            die("heard nothing before the dictation timed out")
        final = clean(final).strip()
        if not final:
            die("heard nothing")
        print(final)
    finally:
        if accepted:
            best_effort_stop("stop-dictation")
        server.close()
        try:
            os.unlink(path)
        except OSError:
            pass


operation = sys.argv[1]
if operation == "speak":
    cmd_speak()
elif operation == "stop":
    cmd_stop()
elif operation == "status":
    cmd_status()
elif operation == "dictate-pane":
    cmd_dictate_pane(sys.argv[2], int(sys.argv[3]))
elif operation == "dictate":
    cmd_dictate(int(sys.argv[2]))
else:
    die("unknown voice request: %s" % operation, 2)
PY
}

_kilix_voice_request() {
  KILIX_VOICE_SESSION="$_KILIX_VOICE_SESSION" \
  KILIX_VOICE_DAEMON="$(_kilix_voice_daemon)" \
  KILIX_VOICE_SPAWN="${_KILIX_VOICE_SPAWN:-0}" \
  python3 -c "$(_kilix_voice_client)" "$@"
}

# Never spawns: reporting that the daemon is stopped must not start it.
_kilix_voice_daemon_state() {
  if _kilix_voice_request status >/dev/null 2>&1; then
    echo running
  elif [ -S "$_KILIX_VOICE_CONTROL" ]; then
    echo unresponsive
  else
    echo "not running"
  fi
}

_kilix_voice_summary() {
  _kilix_read_voice_config
  printf 'speak %s, dictate %s (%s / %s); daemon %s\n' \
    "$(_kilix_voice_onoff "$_KILIX_VOICE_SPEAK")" \
    "$(_kilix_voice_onoff "$_KILIX_VOICE_DICTATE")" \
    "$_KILIX_VOICE_TTS_ENGINE" "$_KILIX_VOICE_STT_ENGINE" \
    "$(_kilix_voice_daemon_state)"
}

_kilix_voice_found() {
  local candidate resolved
  for candidate in "$@"; do
    resolved="$(command -v "$candidate" 2>/dev/null || true)"
    if [ -n "$resolved" ]; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done
  printf 'not found\n'
}

# What doctor prints for the three voice tools: the resolution the launch
# paths actually use — PATH first, then the prefix the pinned installer links
# into. A bare PATH probe once reported "kilix-voiced: not found" one line
# under "daemon: running" whenever ~/.local/bin was off PATH; doctor must
# describe the tool that would run, and say so when PATH cannot see it.
_kilix_voice_tool_state() {
  local name="$1" resolved
  resolved="$(command -v "$name" 2>/dev/null || true)"
  if [ -n "$resolved" ]; then
    printf '%s\n' "$resolved"
  elif [ -x "$_KILIX_VOICE_PREFIX/bin/$name" ]; then
    printf '%s (installed; not on PATH)\n' "$_KILIX_VOICE_PREFIX/bin/$name"
  else
    printf 'not installed (no %s on PATH or in %s/bin)\n' \
      "$name" "$_KILIX_VOICE_PREFIX"
  fi
}

_kilix_voice_doctor() {
  local info server default_source default_sink library model cap tool
  _kilix_read_voice_config
  cap="$_KILIX_VOICE_TTS_MAX_CHARS"
  [ "$cap" = unlimited ] || cap="$cap characters"
  library="$_KILIX_VOICE_DATA/lib/current/libvosk.so"
  model="$_KILIX_VOICE_DATA/models/$_KILIX_VOICE_STT_MODEL"
  # pactl is the probe rather than opening a device: doctor must never be the
  # thing that turns the microphone on.
  info="$(command -v pactl >/dev/null 2>&1 && pactl info 2>/dev/null || true)"
  server="$(printf '%s\n' "$info" | awk -F': ' '
    $1 == "Server Name" { name = $2 } $1 == "Server Version" { version = $2 }
    END { if (name != "") print name (version == "" ? "" : " " version) }')"
  default_source="$(printf '%s\n' "$info" \
    | awk -F': ' '$1 == "Default Source" { print $2 }')"
  default_sink="$(printf '%s\n' "$info" \
    | awk -F': ' '$1 == "Default Sink" { print $2 }')"
  printf '%s\n' \
    "widgets: speak $(_kilix_voice_onoff "$_KILIX_VOICE_SPEAK"), dictate $(_kilix_voice_onoff "$_KILIX_VOICE_DICTATE")" \
    "read-aloud: $_KILIX_VOICE_TTS_ENGINE, voice $_KILIX_VOICE_TTS_VOICE, $_KILIX_VOICE_TTS_RATE wpm, extent $_KILIX_VOICE_TTS_EXTENT, cap $cap" \
    "dictation: $_KILIX_VOICE_STT_ENGINE, model $_KILIX_VOICE_STT_MODEL, stops after ${_KILIX_VOICE_STT_MAX_SECONDS}s or ${_KILIX_VOICE_STT_SILENCE_MS}ms of silence" \
    "submit policy: $_KILIX_VOICE_STT_SUBMIT (dictation never presses Enter on its own)" \
    "spoken punctuation: $(_kilix_voice_onoff "$_KILIX_VOICE_STT_PUNCTUATION")" \
    "dictation history: $(_kilix_voice_onoff "$_KILIX_VOICE_HISTORY")" \
    "synthesizer: $(_kilix_voice_found espeak-ng espeak)" \
    "mbrola voices: $(_kilix_voice_found mbrola) (optional quality tier)" \
    "capture: $(_kilix_voice_found parec arecord)" \
    "playback: $(_kilix_voice_found pacat aplay paplay)" \
    "audio server: ${server:-unreachable}" \
    "input device: $_KILIX_VOICE_DEVICE_IN${default_source:+ ($default_source)}" \
    "output device: $_KILIX_VOICE_DEVICE_OUT${default_sink:+ ($default_sink)}"
  if [ -f "$library" ]; then
    printf 'speech library: %s\n' "$library"
  else
    printf 'speech library: not installed (%s)\n' "$library"
  fi
  if [ -d "$model" ]; then
    printf 'speech model: %s\n' "$model"
  else
    printf 'speech model: not installed (%s)\n' "$model"
  fi
  printf 'daemon: %s (%s)\n' "$(_kilix_voice_daemon_state)" "$_KILIX_VOICE_CONTROL"
  for tool in kilix-voiced kilix-tts kilix-stt; do
    printf '%s: %s\n' "$tool" "$(_kilix_voice_tool_state "$tool")"
  done
  printf 'model pins: %s\n' \
    "$("$KILIX_HOME/scripts/install-kilix-voice.sh" --print-refs 2>/dev/null \
       | tr '\n' ' ' || echo unavailable)"
}

# Read a live pane through the allowlisted `get-text`, exactly as `kilix watch`
# does. A missing engine is not worth a build here: with no kilix running there
# is no pane to read, so speaking must never trigger one.
_kilix_voice_pane_text() {
  local pane="$1" extent="$2" kitten target text password=()
  kitten="${KILIX_KITTEN:-}"
  if [ -z "$kitten" ]; then
    if [ -x "$FORK" ]; then kitten="$(dirname "$FORK")/kitten"
    elif [ -x "$PREBUILT" ]; then kitten="$(dirname "$PREBUILT")/kitten"
    fi
  fi
  [ -n "$kitten" ] && [ -x "$kitten" ] || {
    echo "kilix speak: kitten not found next to the kilix engine; pass the text to speak instead" >&2
    return 1
  }
  [ -n "${KITTY_LISTEN_ON:-}" ] || {
    echo "kilix speak: no live kilix remote-control socket (run this inside kilix, or pass the text to speak)" >&2
    return 1
  }
  target="$pane"
  [ -n "$target" ] || target="${KITTY_WINDOW_ID:-}"
  [ -n "$target" ] || {
    echo "kilix speak: no pane to read (pass --pane ID, or run this inside a kilix pane)" >&2
    return 1
  }
  case "$extent" in
    scrollback) extent=all ;;
    selection) extent=selection ;;
    *) extent=screen ;;
  esac
  [ -z "${KILIX_RC_PASSWORD_FILE:-}" ] \
    || password=(--password-file "$KILIX_RC_PASSWORD_FILE")
  text="$("$kitten" @ "${password[@]}" \
    get-text --match "id:$target" --extent "$extent")" || {
    echo "kilix speak: could not read pane $target" >&2
    return 1
  }
  if [ -z "${text//[[:space:]]/}" ] && [ "$extent" = selection ]; then
    echo "kilix speak: nothing is selected in pane $target" >&2
    return 1
  fi
  printf '%s' "$text"
}

case "${1:-}" in
  # build.sh is invoked from the checkout root everywhere: it is cwd-independent
  # today, but running it from the caller's directory would let any future
  # cwd-relative path in it touch an unrelated tree.
  --build) shift; cd "$KILIX_HOME"; exec "$KILIX_HOME/build.sh" "$@" ;;
  --kilix-version|kilix-version)
    # The Plebian-OS release version of this kilix checkout. (Plain `--version`
    # is passed through to the kitty engine by --which/exec, so this is a
    # distinct flag for the launcher's own version.)
    cat "$KILIX_HOME/VERSION" 2>/dev/null || echo unknown
    exit 0 ;;
  settings|--settings)
    shift
    exec python3 "$KILIX_HOME/kilix-settings" "$@" ;;
  cap|kilix-cap|mansion)
    shift
    export KILIX_DESKTOP_PROVIDER=cap
    export KILIX_DESKTOP_NAME="${KILIX_DESKTOP_NAME:-Kilix Cap}"
    set -- desktop "$@" ;;
  tui|kilix-tui)
    shift
    export KILIX_DESKTOP_PROVIDER=tui
    export KILIX_DESKTOP_NAME="${KILIX_DESKTOP_NAME:-Kilix TUI}"
    set -- desktop "$@" ;;
  land|kilix-land|kilix-land-desktop)
    shift
    export KILIX_DESKTOP_PROVIDER=land
    export KILIX_DESKTOP_NAME="${KILIX_DESKTOP_NAME:-Kilix Land}"
    set -- desktop "$@" ;;
  icewm|kilix-icewm)
    shift
    export KILIX_DESKTOP_PROVIDER=icewm
    export KILIX_DESKTOP_NAME="${KILIX_DESKTOP_NAME:-Kilix IceWM}"
    set -- desktop "$@" ;;
  xp|kilix-xp)
    # Kilix 95 wearing its XP theme: the same external provider, one flavor.
    shift
    export KILIX_DESKTOP_PROVIDER=external
    export KILIX_DESKTOP_FLAVOR=xp
    export KILIX_DESKTOP_NAME="${KILIX_DESKTOP_NAME:-Kilix XP}"
    set -- desktop "$@" ;;
  install|--install)
    # One list of everything installable: the pinned content catalog and the
    # coding agents. It drives the desktop's own content module, so installing
    # from here and launching from the Start menu cannot end up on different
    # builds of the same thing.
    shift
    exec python3 "$KILIX_HOME/config/install.py" "$@" ;;
  launcher|--launcher)
    # The launcher catalog TUI: stack programs, discovered XDG applications,
    # the user's desktop-folder launchers, scripts, and a run-a-command row —
    # one tab any desktop can open instead of growing its own list UI.
    # Same install-on-first-use as temps/memory: the pinned kilix-tui-utils
    # closure provides the `kilix-launcher` command.
    shift
    _launcher_install_only=0
    case "${1:-}" in
      --install-only) _launcher_install_only=1; shift ;;
      -h|--help|help)
        echo "usage: $_self launcher [--install-only]"
        echo "opens the launcher catalog (programs, apps, launchers, scripts)"
        exit 0 ;;
    esac
    [ $# -eq 0 ] || {
      echo "usage: $_self launcher [--install-only]" >&2
      exit 2
    }
    _launcher_installed="${KILIX_TUI_UTILS_PREFIX:-$HOME/.local}/bin/kilix-launcher"
    "$KILIX_HOME/scripts/install-kilix-tui-utils.sh" --print-path >/dev/null
    [ -x "$_launcher_installed" ] \
      || { echo "kilix launcher: installer did not create $_launcher_installed" >&2; exit 1; }
    [ "$_launcher_install_only" = 0 ] || exit 0
    exec "$_launcher_installed" ;;
  laptop|--laptop)
    # Laptop session profiles as a host verb: list | open PROFILE | status |
    # close PROFILE. config/laptop.py owns the shared profile convention
    # (~/.local/gpu_terminal/laptop, KILIX_LAPTOP_PROFILES override) and the
    # run registry beside it (run/<profile-id>.pid; liveness is a real
    # kill(pid, 0) check, stale files are deleted on sight). The desktops'
    # laptop objects delegate here when the verb exists — probed the way
    # games.py probes `kilix games play`, so an old host still opens
    # profiles through each desktop's own path.
    shift
    export KILIX_HOME
    exec python3 "$KILIX_HOME/config/laptop.py" "$@" ;;
  games|--games)
    shift
    _games_action="${1:-list}"
    [ $# -eq 0 ] || shift
    _games_usage="usage: $_self games [list|settings|play GAME|enable GAME...|disable GAME...]"
    case "$_games_action" in
      list)
        [ $# -eq 0 ] || {
          echo "$_games_usage" >&2
          exit 2
        }
        exec python3 "$KILIX_HOME/kilix-settings" --print-games ;;
      play)
        # Install-and-boot by catalog id, host-owned. The backend is the
        # bundled desktop's games module — the same kilix_content.Installer
        # closure `kilix install` drives — so a desktop launching a game and
        # this command cannot end up on different builds, and no kilix-95
        # checkout is involved. Desktops (95's Start menu, cap's Game Room,
        # land's TV, the TUI's Games place) delegate here instead of carrying
        # their own install-and-boot logic.
        _games_play_id=""
        _games_play_setup=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --setup-only) _games_play_setup="--setup-only"; shift ;;
            -h|--help|help)
              echo "usage: $_self games play GAME [--setup-only]"
              echo "installs the pinned game if needed, then boots it"
              exit 0 ;;
            -*)
              echo "usage: $_self games play GAME [--setup-only]" >&2
              exit 2 ;;
            *)
              [ -z "$_games_play_id" ] || {
                echo "usage: $_self games play GAME [--setup-only]" >&2
                exit 2
              }
              _games_play_id="$1"; shift ;;
          esac
        done
        [ -n "$_games_play_id" ] || {
          echo "usage: $_self games play GAME [--setup-only]" >&2
          echo "run '$_self games list' for the ids" >&2
          exit 2
        }
        # games.py resolves its own imports from its script directory; the
        # SDK (kilix_content, shared settings) needs the host config root.
        export PYTHONPATH="$KILIX_HOME/config${PYTHONPATH:+:$PYTHONPATH}"
        if [ -n "$_games_play_setup" ]; then
          set -- --setup-only "$_games_play_id"
        else
          set -- "$_games_play_id"
        fi
        exec python3 "$KILIX_HOME/desktop/games.py" "$@" ;;
      settings|configure)
        [ $# -eq 0 ] || {
          echo "usage: $_self games settings" >&2
          exit 2
        }
        exec python3 "$KILIX_HOME/kilix-settings" --section games ;;
      enable|disable)
        [ $# -gt 0 ] || {
          echo "usage: $_self games $_games_action GAME..." >&2
          exit 2
