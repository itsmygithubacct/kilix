      KILIX_VOICE_MODEL_URL|KILIX_VOICE_MODEL_SHA256|\
      KILIX_VOICE_LGRAPH_MODEL_URL|KILIX_VOICE_LGRAPH_MODEL_SHA256|\
      KILIX_NVR_DETECT|KILIX_SOUND_CLASSIFIER|KILIX_OBJECT_DETECTOR|\
      KILIX_LOOK_DIR|KILIX_LOOK_REPO|KILIX_LOOK_REF|KILIX_LOOK_PREFIX|\
      KILIX_LOOK_AUTO_INSTALL|KILIX_LOOK_TRUST_EXISTING_CHECKOUT|\
