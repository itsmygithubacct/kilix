# Installed-command-first, pinned-installer-fallback — the resolution order the
# tab-bar widgets use, so a click and the CLI can never end up running different
# builds. Preferring an installed command also keeps kilix-voice usable while
# KILIX_VOICE_REF is still unpinned and the installer refuses to run.
#
# "Installed" means PATH first and then the voice prefix the pinned installer
# links into: desktop launch contexts often run without ~/.local/bin on PATH,
# and an installed closure that PATH cannot see must be run, not reinstalled.
_kilix_voice_tool() {
  local name="$1" force="$2" resolved installer
  shift 2
  for resolved in "$(command -v "$name" 2>/dev/null || true)" \
                  "$_KILIX_VOICE_PREFIX/bin/$name"; do
    if [ "$force" = 0 ] && [ -n "$resolved" ] && [ -x "$resolved" ] \
        && "$resolved" --version >/dev/null 2>&1; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done
  installer=("$KILIX_HOME/scripts/install-kilix-voice.sh" "$@")
  [ "$force" = 0 ] || installer+=(--force)
  # Installer diagnostics are stderr-only here: this function's stdout is the
  # resolved path its caller execs.
  "${installer[@]}" >&2 || return 1
  resolved="$_KILIX_VOICE_PREFIX/bin/$name"
  [ -x "$resolved" ] || {
    echo "kilix voice: installer did not create $resolved" >&2
    return 1
  }
  printf '%s\n' "$resolved"
}

# Kilix Bonsai resolves the way the two voice TUIs resolve: an installed
# command wins, and otherwise the pinned installer runs and its result is used.
#
# There is deliberately no source-checkout branch. One existed while the
# repository was unpublished, and had to go once it wasn't: a working tree is
# by definition not the pinned closure, so preferring it would mean `kilix
# bonsai` ran different code on a machine that happens to have a source
# directory than on every installed system — for the one tool here whose whole
# job is fetching verified multi-gigabyte artifacts. A developer who wants the
# working tree runs it directly, or installs it with its own install.sh.
#
# The resolved command stays an array so a prefix with whitespace or glob
# characters remains one literal argument.
_KILIX_BONSAI_PREFIX="${KILIX_BONSAI_PREFIX:-$HOME/.local}"
declare -a _KILIX_BONSAI_COMMAND=()
_kilix_bonsai_resolve() {
  local force="$1" resolved
  # PATH first, then the install prefix — the same order _kilix_voice_tool
  # uses and for the same reason: desktop launch contexts run without
  # ~/.local/bin on PATH, and an installed closure PATH cannot see must be
  # run, not reinstalled.
  for resolved in "$(command -v kilix-bonsai 2>/dev/null || true)" \
                  "$_KILIX_BONSAI_PREFIX/bin/kilix-bonsai"; do
    if [ "$force" = 0 ] && [ -n "$resolved" ] && [ -x "$resolved" ]; then
      _KILIX_BONSAI_COMMAND=("$resolved")
      return 0
    fi
  done
  local installer=("$KILIX_HOME/scripts/install-kilix-bonsai.sh")
  [ "$force" = 0 ] || installer+=(--force)
  "${installer[@]}" || return 1
  resolved="$_KILIX_BONSAI_PREFIX/bin/kilix-bonsai"
  [ -x "$resolved" ] || {
    echo "kilix bonsai: installer did not create $resolved" >&2
    return 1
  }
  _KILIX_BONSAI_COMMAND=("$resolved")
}

# Same shape as bonsai's, and for the same reason: an installed closure the
