#!/usr/bin/python3 -I
"""Password dialog invoked by setuid sudo.

The absolute interpreter and isolated mode keep a caller-controlled
PYTHONPATH or user site from replacing this program before it checks
that its parent is setuid sudo.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from kilix_sdk.graphical_askpass import main


if __name__ == "__main__":
    sys.exit(main())
