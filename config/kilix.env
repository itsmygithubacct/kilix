# kilix runtime settings
#
# This tracked file documents immutable defaults for Kilix-specific settings.
# Put user overrides in ~/.local/gpu_terminal/kilix/config/kilix.env. The
# launcher reads simple KEY=value lines and exports only known KILIX_* keys;
# lines are intentionally not shell-evaluated.
# Storage roots are process/service settings, not persisted here: use
# KILIX_STORAGE_HOME and KILIX95_STORAGE_HOME in the launching environment.
#
# Clickable chrome is shared by all projects in
# ~/.local/gpu_terminal/settings.conf and is managed by `kilix-settings`.
# Legacy KILIX_CHROME_CLOCK/BATTERY values here are migrated when that shared
# file is first created, but new chrome preferences belong in settings.conf.
#   KILIX_CHROME_SYSTEM_LOAD_MODE=always  always | auto (>1.0 load, >=1 GiB) | off
#   KILIX_CHROME_PANE_CPU_MODE=auto       auto (>1.0 load) | always | off
#   KILIX_CHROME_PANE_MEMORY_MODE=auto    auto (>=1 GiB) | always | off
#   KILIX_CHROME_SYSTEM_GPU_MODE=always   always | auto (>=10% busy, >512 MiB) | off
#   KILIX_CHROME_PANE_GPU_MODE=auto       auto (>512 MiB, fixed) | always | off
#
# The tab status mark sits before each tab's title: a moon stepping through
# its phases while a program in the tab is working, a dot while the tab is
# idle, coloured by the CPU the tab's panes use. Also in settings.conf:
#   KILIX_TAB_STATUS=1                       1 | 0 (no mark)
#   KILIX_TAB_STATUS_MODERATE_CORES=1.0      yellow from this many cores
#   KILIX_TAB_STATUS_HIGH_CORES=50%          red from this many cores, or this
#                                            share of the machine (never < 2)
#   KILIX_TAB_STATUS_ACTIVE_CORES=0.10       working when using this much CPU
#   KILIX_TAB_STATUS_IDLE_AFTER_SECONDS=5    ...or when it printed this recently
#   KILIX_TAB_STATUS_STEP_SECONDS=1          seconds between moon phases
#   KILIX_TAB_STATUS_SOFTWARE_STEP_SECONDS=4 ...and no faster than this where the
#                                            CPU draws the screen (no graphics
#                                            card: most virtual machines), since
#                                            every step draws a frame
#   KILIX_TAB_STATUS_LOW_COLOR=#8ae234       green
#   KILIX_TAB_STATUS_MODERATE_COLOR=#fce94f  yellow
#   KILIX_TAB_STATUS_HIGH_COLOR=#ef2929      red
#
# The mark, the bell and the symbols on the bars are drawn by Neuronte nets
# when the Neuronte library and its weight files are installed (in
# $NEURONTE_HOME, or in `neuronte` beside the other sources), and by the
# symbol font otherwise. The pane buttons and the widget symbols are drawn
# two cells wide, across the symbol's cell and the blank cell after it, as the
# symbol font draws them; where no blank cell follows, a symbol is drawn in
# its own cell. Also in settings.conf:
#   KILIX_NEURONTE=auto      auto | off (fonts draw everything)
#   KILIX_NEURONTE_WEIGHTS=neuronte-kilix-chrome-v2.nrt neuronte-kilix-chrome-v1.nrt neuronte-term-rest-v1.nrt neuronte-term-dingbat-v1.nrt neuronte-split-v9.nrt
#                            weight files, asked in this order; one that is
#                            not installed is skipped
#   KILIX_NEURONTE_TWO_CELL=auto
#                            auto (the buttons, the widget symbols, the
#                            weather) | off (every symbol in one cell) | a
#                            list of code points, such as U+F0156 U+F073
#   KILIX_NEURONTE_TWO_CELL_WEIGHTS=neuronte-kilix-chrome-v2.nrt
#                            the weight files whose drawings are made for two
#                            cells. A two-cell symbol found only in another
#                            file is drawn from its one-cell drawing, enlarged
#   KILIX_NEURONTE_WEATHER=off
#                            off (colour emoji) | on (one colour, drawn by the
#                            nets, once they hold all nine weather symbols)
#
# Contained browsers (`kilix run chromium`, `kilix run firefox`) get a private,
# disposable profile per launch, so nothing they store outlives the pane. Name
# a directory here and every launch shares it instead -- logins, cookies and
# history persist. An explicit --user-data-dir / --profile on the command line
# still wins. One profile means one browser: a second launch joins the first
# (Chromium) or refuses (Firefox).
#   KILIX_RUN_BROWSER_PROFILE=~/.local/gpu_terminal/kilix/data/browser-profile
#
# Read-aloud and dictation are shared settings as well. KILIX_CHROME_SPEAK and
# KILIX_CHROME_DICTATE show the two tab-bar widgets; the KILIX_VOICE_* keys
# configure what a click does. They exist only in settings.conf: there is no
# legacy value to migrate, so unlike the two chrome keys above they are not
# read from this file. Values are presets, and an unrecognized one reads back
# as the default:
#   KILIX_VOICE_TTS_ENGINE=espeak        espeak | mbrola | off
#   KILIX_VOICE_TTS_VOICE=en-us          synthesizer voice name
#   KILIX_VOICE_TTS_RATE=170             120 | 150 | 170 | 200 | 240 (wpm)
#   KILIX_VOICE_TTS_EXTENT=screen        screen | scrollback | selection
#   KILIX_VOICE_TTS_MAX_CHARS=4000       1000 | 4000 | 16000 | unlimited
#   KILIX_VOICE_STT_ENGINE=vosk          vosk | vibevoice | off
#   KILIX_VOICE_STT_MODEL=small-en-us    small-en-us | lgraph-en-us | vibevoice-asr-bitnet
#   KILIX_VOICE_STT_SUBMIT=never         never | confirm
#   KILIX_VOICE_STT_MAX_SECONDS=30       15 | 30 | 60 | 120
#   KILIX_VOICE_STT_SILENCE_MS=900       500 | 900 | 1500
#   KILIX_VOICE_STT_PUNCTUATION=1        write spoken "period", "new line", ...
#   KILIX_VOICE_DEVICE_IN=default        PulseAudio source name, or default
#   KILIX_VOICE_DEVICE_OUT=default       PulseAudio sink name, or default
#   KILIX_VOICE_HISTORY=off              off | on, kilix-stt's dictation log
# Both widgets ship enabled, which means the buttons are visible and clickable.
# A lone Windows/Super release opens the same Start menu as the top-left button.
# Super combinations remain shortcuts. Set KILIX_CHROME_SUPER_START=0 in the
# shared settings file to restore raw Super events for terminal applications.
# Weather starts with no ZIP. Right-click it, or use kilix settings --widget weather.
# KILIX_WEATHER_ZIP accepts five US ZIP digits. KILIX_WEATHER_REFRESH accepts
# manual, 15, 30, 60, 180 (minutes), or daily with KILIX_WEATHER_TIME=07:00.
# The daily schedule uses local system time and runs only while Kilix is open.
# Nothing opens the microphone until one is clicked, and dictation has no
# setting that submits what it heard: it types the text and stops there.
# `kilix voice install` owns the immutable source/library/model pins. On systems
# without Debian's /usr/share/common-licenses/Apache-2.0, set the following in
# the launching environment (or this override file) to an exact Apache-2.0 text:
# KILIX_VOICE_APACHE_LICENSE_FILE=/absolute/path/to/Apache-2.0
#
# Runtime examples:
# KILIX_DESKTOP_PROVIDER=auto
# `kilix xp` selects both the external provider and this flavor for one launch.
# This flavor alone does not enable a Pleb login desktop; that needs
# PLEB_DESKTOP=1 in Pleb's session.env and `kilix default-desktop set xp`.
# KILIX_DESKTOP_FLAVOR=xp
# KILIX_DESKTOP_PROVIDER=cap
# KILIX_CAP_DIR=/absolute/path/to/kilix-desktops/kilix-cap
# KILIX_CAP_REF=<full-40-character-commit-sha>
# KILIX_CAP_AUTO_INSTALL=1
# KILIX_DESKTOP_PROVIDER=tui
# KILIX_TUI_UTILS_DIR=/absolute/path/to/kilix-desktops/kilix-tui-utils
# KILIX_TUI_UTILS_REF=<full-40-character-commit-sha>
# KILIX_TUI_UTILS_AUTO_INSTALL=1
# KILIX_DESKTOP_PROVIDER=land
# KILIX_LAND_DESKTOP_DIR=/absolute/path/to/kilix-desktops/kilix-land-desktop
# KILIX_LAND_DESKTOP_REF=<full-40-character-commit-sha>
# KILIX_LAND_DESKTOP_AUTO_INSTALL=1
# KILIX_DESKTOP_PROVIDER=icewm
# zell is the RPG Desktop.
# KILIX_DESKTOP_PROVIDER=zell
# KILIX_RUN_AUTO_FIT=1
# KILIX_BROWSE_BACKEND=presenter
# KILIX_HW=1
# KILIX_SHELL_INTEGRATION=0
# KILIX_PTY_BROKER=1
# KILIX_PTY_BROKER_HOME=~/.local/gpu_terminal/sources/kitty-pty-broker
# KILIX_PTY_BROKER_AUTO_RECOVER=1
# KILIX_PTY_BROKER_JOURNAL_LIMIT=67108864
# KILIX_PTY_JOURNAL_BUDGET=268435456
# KILIX95_REF=<full-40-character-commit-sha>
# KILIX95_DIR=~/.local/gpu_terminal/sources/kilix-desktops/kilix-95
# KILIX95_ALLOW_MUTABLE_REF=0
# KILIX95_ALLOW_UNPINNED_INSTALL=0
# KILIX_REPO=https://github.com/itsmygithubacct/kilix.git
# KILIX_TRUST_EXISTING_CHECKOUT=0
# KILIX_ALLOW_MUTABLE_REF=0
# KILIX_PREBUILT_VERSION=0.47.0
# KILIX_PREBUILT_SHA256=<sha256>
# KILIX_ALLOW_UNVERIFIED_PREBUILT=0
# KILIX_BUILD_MODE=system
# KILIX_KITTY_DEPS_URL=<immutable-versioned-asset-url>
# KILIX_KITTY_DEPS_SHA256=<sha256>
# KILIX_NERD_FONT_URL=<versioned-asset-url>
# KILIX_NERD_FONT_SHA256=<sha256>
# KILIX_NERD_FONT_FILE_SHA256=<sha256>

# Pinned Tmux Manager download-on-first-run closure. The launcher supplies
# immutable defaults; uncomment only to point at another reviewed closure.
# TMUX_TUI_REPO=https://github.com/itsmygithubacct/tmux-tui.git
# TMUX_TUI_REF=<full-40-character-commit-sha>
# TMUX_CLI_REF=<full-40-character-commit-sha>
# Prefix overrides must be normalized absolute paths.
# TMUX_TUI_PREFIX=$HOME/.local
# KILIX_GO_TOOLCHAIN=go1.26.5
# KILIX_PYTHON=/path/to/python3.12
